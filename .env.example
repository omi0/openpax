# --- Required -----------------------------------------------------------------
# Postgres connection string
DATABASE_URL=postgres://sitli:sitli@localhost:5432/sitli
# Secret used by Better Auth to sign sessions (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
# 32-byte key (base64) used to encrypt notification provider secrets at rest
# (generate: openssl rand -base64 32). Losing it means re-entering provider credentials.
APP_ENCRYPTION_KEY=change-me
# Public URL where Sitli is reachable (used in emails, widget embed code, auth callbacks)
PUBLIC_URL=http://localhost:3000

# --- Optional -----------------------------------------------------------------
# Port for the server (default 3000)
PORT=3000
# Origin of the dashboard when running Vite dev server separately (default: same origin)
DASHBOARD_ORIGIN=http://localhost:5173
# Instance-wide SMTP fallback used when a restaurant/org has not configured an email provider.
# Example: smtp://user:pass@smtp.example.com:587  (dev with Mailpit: smtp://localhost:1025)
SMTP_URL=
# Sender used with the SMTP fallback
SMTP_FROM="Sitli <no-reply@example.com>"
# pino log level (default info)
LOG_LEVEL=info
# Who can create an account: first_user (default: the first account, then invite-only),
# invite_only, or open (anyone; for hosted multi-tenant instances)
SIGNUP_MODE=first_user
